# Environment variables for Swasthya MONAI Medical Imaging Lab

# Application Mode
DEMO_MODE=true

# Server Configuration
PORT=8501
HOST=localhost

# Model Paths (optional overrides)
XRAY_MODEL_PATH=models/xray/chexnet_monai_densenet121.pth
ULTRASOUND_CLS_MODEL_PATH=models/ultrasound/classification/ultrasound_densenet121.pth
ULTRASOUND_SEG_MODEL_PATH=models/ultrasound/segmentation/ultrasound_unet.pth

# Hardware
FORCE_CPU=false
